pipeline {
    agent any

    environment {
        JAVA_VERSION   = '17'
        NODE_VERSION   = '20'
        REGISTRY       = credentials('docker-registry-url')
        REGISTRY_CREDS = credentials('docker-registry-credentials')
        K8S_NAMESPACE  = 'acadevia'
        SHORT_SHA      = sh(script: "echo ${GIT_COMMIT} | cut -c1-7", returnStdout: true).trim()
    }

    options {
        buildDiscarder(logRotator(numToKeepsStr: '20'))
        timeout(time: 60, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
    }

    tools {
        jdk "jdk-${JAVA_VERSION}"
        maven 'maven-3.9'
        nodejs "node-${NODE_VERSION}"
    }

    parameters {
        choice(
            name: 'DEPLOY_ENV',
            choices: ['none', 'staging', 'production'],
            description: 'Target deployment environment'
        )
        booleanParam(
            name: 'SKIP_TESTS',
            defaultValue: false,
            description: 'Skip test execution'
        )
        booleanParam(
            name: 'FORCE_BUILD_ALL',
            defaultValue: false,
            description: 'Build all services regardless of changes'
        )
    }

    stages {

        // =====================================================================
        // STAGE 1: Build
        // =====================================================================
        stage('Build') {
            parallel {
                stage('Build Backend Services') {
                    steps {
                        script {
                            def services = [
                                'config-server', 'service-registry', 'api-gateway',
                                'auth-service', 'user-service', 'course-service',
                                'content-service', 'quiz-service', 'game-service',
                                'sync-service', 'gamification-service', 'leaderboard-service',
                                'notification-service', 'analytics-service', 'admin-service',
                                'locale-service'
                            ]

                            for (svc in services) {
                                dir(svc) {
                                    sh "mvn clean package -DskipTests -B"
                                }
                            }
                        }
                    }
                }

                stage('Build Frontend') {
                    steps {
                        dir('acadevia-frontend') {
                            sh 'npm ci'
                            sh 'npm run build'
                        }
                    }
                }
            }
        }

        // =====================================================================
        // STAGE 2: Test
        // =====================================================================
        stage('Test') {
            when {
                expression { return !params.SKIP_TESTS }
            }
            parallel {
                stage('Backend Tests') {
                    steps {
                        script {
                            def services = [
                                'auth-service', 'user-service', 'course-service',
                                'content-service', 'quiz-service', 'game-service',
                                'gamification-service', 'leaderboard-service',
                                'notification-service', 'admin-service'
                            ]

                            for (svc in services) {
                                dir(svc) {
                                    sh "mvn verify -B"
                                }
                            }
                        }
                    }
                    post {
                        always {
                            junit '**/target/surefire-reports/*.xml'
                            jacoco(
                                execPattern: '**/target/jacoco.exec',
                                classPattern: '**/target/classes',
                                sourcePattern: '**/src/main/java'
                            )
                        }
                    }
                }

                stage('Frontend Tests') {
                    steps {
                        dir('acadevia-frontend') {
                            sh 'npm run lint'
                            sh 'npx tsc --noEmit'
                            sh 'npx vitest run --coverage'
                        }
                    }
                    post {
                        always {
                            publishHTML(target: [
                                allowMissing: true,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: 'acadevia-frontend/coverage',
                                reportFiles: 'index.html',
                                reportName: 'Frontend Coverage'
                            ])
                        }
                    }
                }
            }
        }

        // =====================================================================
        // STAGE 3: Docker Build
        // =====================================================================
        stage('Docker Build') {
            steps {
                script {
                    def services = [
                        'config-server', 'service-registry', 'api-gateway',
                        'auth-service', 'user-service', 'course-service',
                        'content-service', 'quiz-service', 'game-service',
                        'sync-service', 'gamification-service', 'leaderboard-service',
                        'notification-service', 'analytics-service', 'admin-service',
                        'locale-service', 'acadevia-frontend'
                    ]

                    withDockerRegistry([credentialsId: 'docker-registry-credentials', url: "https://${REGISTRY}"]) {
                        for (svc in services) {
                            def tag = "${REGISTRY}/${svc}:${SHORT_SHA}"
                            def latestTag = "${REGISTRY}/${svc}:latest"

                            sh """
                                docker build -t ${tag} -t ${latestTag} -f ${svc}/Dockerfile ${svc}
                                docker push ${tag}
                                docker push ${latestTag}
                            """
                        }
                    }
                }
            }
        }

        // =====================================================================
        // STAGE 4: Security Scan
        // =====================================================================
        stage('Security Scan') {
            parallel {
                stage('Trivy Image Scan') {
                    steps {
                        script {
                            def services = [
                                'api-gateway', 'auth-service', 'user-service',
                                'course-service', 'content-service', 'quiz-service',
                                'game-service', 'notification-service'
                            ]

                            for (svc in services) {
                                sh """
                                    trivy image --severity CRITICAL,HIGH \
                                        --format table \
                                        --output trivy-${svc}.txt \
                                        ${REGISTRY}/${svc}:${SHORT_SHA} || true
                                """
                            }
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'trivy-*.txt', allowEmptyArchive: true
                        }
                    }
                }

                stage('OWASP Dependency Check') {
                    steps {
                        sh '''
                            mvn org.owasp:dependency-check-maven:check \
                                -DfailBuildOnCVSS=9 \
                                -Dformats=HTML,JSON \
                                -B || true
                        '''
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: '**/target/dependency-check-report.*', allowEmptyArchive: true
                        }
                    }
                }
            }
        }

        // =====================================================================
        // STAGE 5: Deploy to Staging
        // =====================================================================
        stage('Deploy Staging') {
            when {
                anyOf {
                    branch 'develop'
                    expression { return params.DEPLOY_ENV == 'staging' }
                }
            }
            steps {
                script {
                    withKubeConfig([credentialsId: 'staging-kubeconfig']) {
                        // Run DB migrations
                        sh """
                            kubectl apply -f acadevia-infrastructure/kubernetes/jobs/db-migration-job.yml \
                                -n ${K8S_NAMESPACE}-staging || true
                            kubectl wait --for=condition=complete job/db-migration \
                                -n ${K8S_NAMESPACE}-staging --timeout=120s || true
                        """

                        // Update services
                        def services = [
                            'config-server', 'service-registry', 'api-gateway',
                            'auth-service', 'user-service', 'course-service',
                            'content-service', 'quiz-service', 'game-service',
                            'sync-service', 'gamification-service', 'leaderboard-service',
                            'notification-service', 'analytics-service', 'admin-service',
                            'locale-service', 'acadevia-frontend'
                        ]

                        for (svc in services) {
                            sh """
                                kubectl set image deployment/${svc} \
                                    ${svc}=${REGISTRY}/${svc}:${SHORT_SHA} \
                                    -n ${K8S_NAMESPACE}-staging || true
                            """
                        }

                        // Wait for rollouts
                        for (svc in services) {
                            sh """
                                kubectl rollout status deployment/${svc} \
                                    -n ${K8S_NAMESPACE}-staging --timeout=300s || true
                            """
                        }

                        // Smoke tests
                        sh '''
                            GATEWAY=$(kubectl get svc api-gateway \
                                -n ${K8S_NAMESPACE}-staging \
                                -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || echo "localhost")
                            curl -sf "http://${GATEWAY}/actuator/health" --max-time 10 || echo "Smoke test warning"
                        '''
                    }
                }
            }
        }

        // =====================================================================
        // STAGE 6: Deploy to Production
        // =====================================================================
        stage('Deploy Production') {
            when {
                anyOf {
                    branch 'main'
                    expression { return params.DEPLOY_ENV == 'production' }
                }
            }
            steps {
                // Manual approval gate
                input message: 'Deploy to Production?', ok: 'Deploy',
                    submitter: 'admin,devops'

                script {
                    withKubeConfig([credentialsId: 'production-kubeconfig']) {
                        // Run DB migrations
                        sh """
                            kubectl apply -f acadevia-infrastructure/kubernetes/jobs/db-migration-job.yml \
                                -n ${K8S_NAMESPACE}-production || true
                            kubectl wait --for=condition=complete job/db-migration \
                                -n ${K8S_NAMESPACE}-production --timeout=180s
                        """

                        // Rolling update
                        def services = [
                            'config-server', 'service-registry', 'api-gateway',
                            'auth-service', 'user-service', 'course-service',
                            'content-service', 'quiz-service', 'game-service',
                            'sync-service', 'gamification-service', 'leaderboard-service',
                            'notification-service', 'analytics-service', 'admin-service',
                            'locale-service', 'acadevia-frontend'
                        ]

                        for (svc in services) {
                            sh """
                                kubectl set image deployment/${svc} \
                                    ${svc}=${REGISTRY}/${svc}:${SHORT_SHA} \
                                    -n ${K8S_NAMESPACE}-production
                            """
                        }

                        // Wait for rollouts and rollback on failure
                        def rolloutFailed = false
                        for (svc in services) {
                            def status = sh(
                                script: """
                                    kubectl rollout status deployment/${svc} \
                                        -n ${K8S_NAMESPACE}-production --timeout=300s
                                """,
                                returnStatus: true
                            )
                            if (status != 0) {
                                rolloutFailed = true
                                echo "WARNING: Rollout failed for ${svc}"
                            }
                        }

                        // Smoke tests
                        def smokeResult = sh(
                            script: '''
                                GATEWAY=$(kubectl get svc api-gateway \
                                    -n ${K8S_NAMESPACE}-production \
                                    -o jsonpath='{.status.loadBalancer.ingress[0].hostname}')
                                curl -sf "http://${GATEWAY}/actuator/health" --max-time 15
                            ''',
                            returnStatus: true
                        )

                        if (rolloutFailed || smokeResult != 0) {
                            echo "ROLLING BACK ALL SERVICES..."
                            for (svc in services) {
                                sh """
                                    kubectl rollout undo deployment/${svc} \
                                        -n ${K8S_NAMESPACE}-production || true
                                """
                            }
                            error("Production deployment failed — rollback executed!")
                        }

                        // Tag release
                        sh """
                            git tag "v\$(date +'%Y%m%d')-${SHORT_SHA}"
                            git push origin "v\$(date +'%Y%m%d')-${SHORT_SHA}"
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            slackSend(
                channel: '#deployments',
                color: 'good',
                message: "✅ *${env.JOB_NAME}* #${env.BUILD_NUMBER} succeeded\n" +
                         "Branch: `${env.GIT_BRANCH}`\n" +
                         "Commit: `${SHORT_SHA}`\n" +
                         "<${env.BUILD_URL}|View Build>"
            )
        }
        failure {
            slackSend(
                channel: '#deployments',
                color: 'danger',
                message: "❌ *${env.JOB_NAME}* #${env.BUILD_NUMBER} FAILED\n" +
                         "Branch: `${env.GIT_BRANCH}`\n" +
                         "Commit: `${SHORT_SHA}`\n" +
                         "<${env.BUILD_URL}|View Build>"
            )
        }
        always {
            cleanWs()
        }
    }
}
