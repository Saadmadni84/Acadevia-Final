# ============================================================
# Cloudflare R2 Credentials & Storage Configuration Example
# Copy this file to .env.r2 or paste these values into your .env:
#   cp .env.r2.example .env.r2
# ============================================================

# Replace with your Cloudflare R2 Account ID:
# Found in: Cloudflare Dashboard > R2 Overview > Account ID (right sidebar)
STORAGE_ENDPOINT=https://<YOUR_CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com

# Replace with your Cloudflare R2 Access Key ID and Secret Access Key:
# Created in: Cloudflare Dashboard > R2 > Manage R2 API Tokens > Create API Token
# Permissions: Object Read & Write
# Bucket scope: Include acadevia-videos (or all buckets)
STORAGE_ACCESS_KEY=your_r2_access_key_id_here
STORAGE_SECRET_KEY=your_r2_secret_access_key_here

# R2 region is always 'auto'
STORAGE_REGION=auto

# R2 requires S3 path-style addressing
STORAGE_PATH_STYLE_ENABLED=true

# Buckets (pre-created in Cloudflare R2)
STORAGE_BUCKET_VIDEOS=acadevia-videos
STORAGE_BUCKET_IMAGES=acadevia-images
STORAGE_BUCKET_DOCUMENTS=acadevia-documents
STORAGE_BUCKET_BACKUPS=acadevia-backups

# Public Presigned URL base (same as STORAGE_ENDPOINT)
STORAGE_PUBLIC_URL=https://<YOUR_CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
