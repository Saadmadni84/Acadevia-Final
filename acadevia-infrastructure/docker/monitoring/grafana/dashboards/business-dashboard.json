{
  "uid": "acadevia-business",
  "title": "Acadevia — Business Metrics",
  "tags": ["acadevia", "business", "kpi"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Daily Active Users (DAU)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "acadevia_daily_active_users",
          "legendFormat": "DAU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "green", "value": 500 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "New Registrations (24h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "increase(acadevia_user_registrations_total[24h])",
          "legendFormat": "registrations"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Courses Completed (24h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "increase(acadevia_courses_completed_total[24h])",
          "legendFormat": "completed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "XP Distributed (24h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "increase(acadevia_xp_distributed_total[24h])",
          "legendFormat": "XP"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "purple", "value": null },
              { "color": "green", "value": 1000 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "User Registrations Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "increase(acadevia_user_registrations_total[1h])",
          "legendFormat": "registrations/hr"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "drawStyle": "bars" }
        }
      }
    },
    {
      "id": 6,
      "title": "Course Completions Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "increase(acadevia_courses_completed_total[1h])",
          "legendFormat": "completions/hr"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "drawStyle": "bars" }
        }
      }
    },
    {
      "id": 7,
      "title": "Quiz Attempts (24h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "increase(acadevia_quiz_attempts_total[24h])",
          "legendFormat": "attempts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "title": "Games Played (24h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 14 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "increase(acadevia_games_played_total[24h])",
          "legendFormat": "games"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 20 }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "title": "Active Sessions",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 14 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "acadevia_active_sessions",
          "legendFormat": "sessions"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 10 },
              { "color": "yellow", "value": 500 }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "XP Distribution Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "increase(acadevia_xp_distributed_total[1h])",
          "legendFormat": "XP/hr"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      }
    },
    {
      "id": 11,
      "title": "Quiz Pass Rate",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "acadevia_quiz_pass_total / acadevia_quiz_attempts_total * 100",
          "legendFormat": "pass rate %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 75 }
            ]
          }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
