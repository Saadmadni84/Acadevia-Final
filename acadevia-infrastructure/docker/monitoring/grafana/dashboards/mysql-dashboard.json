{
  "uid": "acadevia-mysql",
  "title": "Acadevia — MySQL",
  "tags": ["acadevia", "mysql", "database"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Active Connections",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected",
          "legendFormat": "connected"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 200,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 180 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Connection Pool Usage %",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected / mysql_global_variables_max_connections * 100",
          "legendFormat": "usage %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Queries Per Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "rate(mysql_global_status_queries[5m])",
          "legendFormat": "total QPS"
        },
        {
          "expr": "rate(mysql_global_status_commands_total{command=\"select\"}[5m])",
          "legendFormat": "SELECT"
        },
        {
          "expr": "rate(mysql_global_status_commands_total{command=\"insert\"}[5m])",
          "legendFormat": "INSERT"
        },
        {
          "expr": "rate(mysql_global_status_commands_total{command=\"update\"}[5m])",
          "legendFormat": "UPDATE"
        },
        {
          "expr": "rate(mysql_global_status_commands_total{command=\"delete\"}[5m])",
          "legendFormat": "DELETE"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      }
    },
    {
      "id": 4,
      "title": "Slow Queries / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "rate(mysql_global_status_slow_queries[1m]) * 60",
          "legendFormat": "slow queries/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Replication Lag",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "mysql_slave_status_seconds_behind_master",
          "legendFormat": "lag (seconds)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 30 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Buffer Pool Hit Ratio",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "(1 - (mysql_global_status_innodb_buffer_pool_reads / mysql_global_status_innodb_buffer_pool_read_requests)) * 100",
          "legendFormat": "hit ratio %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 98 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "InnoDB Buffer Pool Size",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "mysql_global_variables_innodb_buffer_pool_size",
          "legendFormat": "buffer pool"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "id": 8,
      "title": "Threads Running",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "mysql_global_status_threads_running",
          "legendFormat": "running"
        },
        {
          "expr": "mysql_global_status_threads_connected",
          "legendFormat": "connected"
        },
        {
          "expr": "mysql_global_status_threads_cached",
          "legendFormat": "cached"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
