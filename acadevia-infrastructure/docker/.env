# ============================================================
# Acadevia Platform — Local Development Environment Variables
# ============================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ---- Per-Service Database Credentials ----
# auth-service
AUTH_DB_NAME=acadevia_auth
AUTH_DB_USER=auth_user
AUTH_DB_PASS=auth_pass

# user-service
USER_DB_NAME=acadevia_users
USER_DB_USER=user_user
USER_DB_PASS=user_pass

# course-service
COURSE_DB_NAME=acadevia_courses
COURSE_DB_USER=course_user
COURSE_DB_PASS=course_pass

# content-service
CONTENT_DB_NAME=acadevia_content
CONTENT_DB_USER=content_user
CONTENT_DB_PASS=content_pass

# quiz-service
QUIZ_DB_NAME=acadevia_quiz
QUIZ_DB_USER=quiz_user
QUIZ_DB_PASS=quiz_pass

# game-service
GAME_DB_NAME=acadevia_game
GAME_DB_USER=game_user
GAME_DB_PASS=game_pass

# sync-service
SYNC_DB_NAME=acadevia_sync
SYNC_DB_USER=sync_user
SYNC_DB_PASS=sync_pass

# gamification-service
GAMIFICATION_DB_NAME=acadevia_gamification
GAMIFICATION_DB_USER=gamification_user
GAMIFICATION_DB_PASS=gamification_pass

# leaderboard-service
LEADERBOARD_DB_NAME=acadevia_leaderboard
LEADERBOARD_DB_USER=leaderboard_user
LEADERBOARD_DB_PASS=leaderboard_pass

# notification-service
NOTIFICATION_DB_NAME=acadevia_notification
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASS=notification_pass

# analytics-service
ANALYTICS_DB_NAME=acadevia_analytics
ANALYTICS_DB_USER=analytics_user
ANALYTICS_DB_PASS=analytics_pass

# admin-service
ADMIN_DB_NAME=acadevia_admin
ADMIN_DB_USER=admin_user
ADMIN_DB_PASS=admin_pass

# i18n-service (locale)
I18N_DB_NAME=acadevia_i18n
I18N_DB_USER=i18n_user
I18N_DB_PASS=i18n_pass

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ---- JWT ----
JWT_SECRET=local-dev-jwt-secret-key-change-in-production-acadevia-2026
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=604800000

# ---- MinIO (S3-compatible Object Storage) ----
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_CONTENT=acadevia-content
MINIO_BUCKET_AVATARS=acadevia-avatars
MINIO_BUCKET_EXPORTS=acadevia-exports

# ---- CDN ----
CDN_BASE_URL=http://localhost:9000

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080
VITE_SOCKET_URL=ws://localhost:8080

# ---- Grafana ----
GRAFANA_ADMIN_PASSWORD=admin

# ---- SMTP (Email) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---- SMS ----
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=

# ---- FCM (Firebase Cloud Messaging) ----
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# ---- Docker Image Config ----
IMAGE_TAG=latest
REGISTRY=acadevia

# ---- Spring ----
SPRING_PROFILES_ACTIVE=docker
