# ============================================================
# Acadevia Platform — Environment Configuration Template
# ============================================================
# Copy this file to '.env' for local development or production:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit a '.env' containing real secrets to Git.
# 2. Keep all storage credentials strictly backend-side (never in frontend).
# ============================================================

# ============================================================
# 1. DATABASE CONFIGURATION (MySQL 8.0)
# ============================================================
# --- Local Docker MySQL (Default) ---
MYSQL_ROOT_PASSWORD=change_this_local_root_password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# --- Shared Cloud MySQL (AWS RDS / Aiven / DigitalOcean Managed DB) ---
# To use a shared cloud database for all team members/environments,
# point MYSQL_HOST to your cloud instance endpoint (e.g. mydb.xxxx.rds.amazonaws.com)
# and set DB_USE_SSL=true.
# Optional: Provide a full JDBC URL override (e.g. jdbc:mysql://host:3306/acadevia_content?sslMode=REQUIRED)
DB_URL=
DB_USE_SSL=false

# Per-Service Database Names & Credentials (one schema per service)
AUTH_DB_NAME=acadevia_auth
AUTH_DB_USER=auth_user
AUTH_DB_PASS=auth_secure_pass

USER_DB_NAME=acadevia_user
USER_DB_USER=user_user
USER_DB_PASS=user_secure_pass

COURSE_DB_NAME=acadevia_course
COURSE_DB_USER=course_user
COURSE_DB_PASS=course_secure_pass

CONTENT_DB_NAME=acadevia_content
CONTENT_DB_USER=content_user
CONTENT_DB_PASS=content_secure_pass

QUIZ_DB_NAME=acadevia_quiz
QUIZ_DB_USER=quiz_user
QUIZ_DB_PASS=quiz_secure_pass

GAME_DB_NAME=acadevia_game
GAME_DB_USER=game_user
GAME_DB_PASS=game_secure_pass

SYNC_DB_NAME=acadevia_sync
SYNC_DB_USER=sync_user
SYNC_DB_PASS=sync_secure_pass

GAMIFICATION_DB_NAME=acadevia_gamification
GAMIFICATION_DB_USER=gamification_user
GAMIFICATION_DB_PASS=gamification_secure_pass

LEADERBOARD_DB_NAME=acadevia_leaderboard
LEADERBOARD_DB_USER=leaderboard_user
LEADERBOARD_DB_PASS=leaderboard_secure_pass

NOTIFICATION_DB_NAME=acadevia_notification
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASS=notification_secure_pass

ANALYTICS_DB_NAME=acadevia_analytics
ANALYTICS_DB_USER=analytics_user
ANALYTICS_DB_PASS=analytics_secure_pass

ADMIN_DB_NAME=acadevia_admin
ADMIN_DB_USER=admin_user
ADMIN_DB_PASS=admin_secure_pass

I18N_DB_NAME=acadevia_locale
I18N_DB_USER=i18n_user
I18N_DB_PASS=i18n_secure_pass

# ============================================================
# 2. OBJECT STORAGE (S3-Compatible / Cloudflare R2 / AWS S3 / MinIO)
# ============================================================
# The backend dynamically signs presigned URLs for playback & downloads.
# All buckets must remain PRIVATE. Frontend never receives access keys.

# --- Option A: Local Docker MinIO (Default for local development) ---
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
# Host-accessible endpoint returned to browser for presigned playback URLs
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_PATH_STYLE_ENABLED=true

# --- Option B: Cloudflare R2 (Recommended for Production - Zero Egress Fees) ---
# STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=<r2_access_key_id>
# STORAGE_SECRET_KEY=<r2_secret_access_key>
# STORAGE_REGION=auto
# STORAGE_PUBLIC_URL=https://<account_id>.r2.cloudflarestorage.com  # or your custom CDN domain https://cdn.acadevia.com
# STORAGE_PATH_STYLE_ENABLED=true

# --- Option C: AWS S3 ---
# STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
# STORAGE_ACCESS_KEY=<aws_access_key_id>
# STORAGE_SECRET_KEY=<aws_secret_access_key>
# STORAGE_REGION=us-east-1
# STORAGE_PUBLIC_URL=https://s3.us-east-1.amazonaws.com
# STORAGE_PATH_STYLE_ENABLED=false

# Storage Buckets (must exist in storage provider)
STORAGE_BUCKET_VIDEOS=acadevia-videos
STORAGE_BUCKET_IMAGES=acadevia-images
STORAGE_BUCKET_DOCUMENTS=acadevia-documents
STORAGE_BUCKET_BACKUPS=acadevia-backups
STORAGE_PRESIGNED_EXPIRY_MINUTES=15

# Legacy compatibility aliases for local scripts
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
CDN_BASE_URL=http://localhost:9000

# ============================================================
# 3. CACHING & EVENT BUS
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ============================================================
# 4. SECURITY & AUTHENTICATION
# ============================================================
# Generate a strong 256/384-bit random key for production
JWT_SECRET=change_this_to_a_secure_jwt_secret_in_production_acadevia_2026
JWT_ACCESS_EXPIRY=900000        # 15 minutes in ms
JWT_REFRESH_EXPIRY=604800000    # 7 days in ms

# ============================================================
# 5. FRONTEND & GATEWAY
# ============================================================
# When sharing with friends/team members, set VITE_API_BASE_URL to your
# deployed Gateway address (e.g. https://api.acadevia.com)
VITE_API_BASE_URL=http://localhost:8080
VITE_SOCKET_URL=ws://localhost:8080

# ============================================================
# 6. OBSERVABILITY & PLATFORM
# ============================================================
GRAFANA_ADMIN_PASSWORD=admin_secure_change_me
IMAGE_TAG=latest
REGISTRY=acadevia
SPRING_PROFILES_ACTIVE=docker
